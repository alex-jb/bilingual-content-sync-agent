# Required for LLM translation. Without it, the agent runs in template mode
# (review file written, ZH proposals empty — fill manually).
ANTHROPIC_API_KEY=sk-ant-...

# Optional: model override. Default is Sonnet 4.6 (translation needs nuance).
# BILINGUAL_TRANSLATE_MODEL=claude-sonnet-4-6

# Optional: how many keys per Claude call. Higher = fewer calls but each
# is slower. Default 50 hits the token-budget sweet spot for ~50-char keys.
# BILINGUAL_BATCH_SIZE=50

# Optional: where the HITL queue lives.
# BILINGUAL_QUEUE=~/.bilingual-content-sync-agent/queue

# Bypass — no-op if set to 1
# BILINGUAL_SKIP=0
